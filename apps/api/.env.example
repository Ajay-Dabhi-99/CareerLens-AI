NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Supabase (Phase 2+)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key

# Gemini API / Google AI Studio (Phase 6+)
GEMINI_API_KEY=replace-with-gemini-api-key
# Optional. Google retires models on its own schedule, so this is configurable
# rather than pinned in code. Free-tier daily quotas differ sharply per model:
# gemini-3.8-flash allowed only 20 requests/day during development, while the
# flash-lite models were far more generous.
GEMINI_MODEL=gemini-3.5-flash-lite
